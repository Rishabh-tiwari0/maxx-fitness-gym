rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI: npm install -g firebase-tools, then firebase init)
//
// Development-only rules for this prototype app. Allow read/write without
// Firebase auth so the admin dashboard and member form work while the app is
// being built/tested. Tighten this later when you add real staff auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
