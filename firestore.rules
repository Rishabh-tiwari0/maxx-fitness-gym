rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI: npm install -g firebase-tools, then firebase init)
//
// This app is single-admin/staff, not member-facing, so the simplest safe
// rule is: any signed-in user can read/write. If you add multiple staff
// accounts later and want to restrict further, add a custom claim (e.g.
// "role": "admin") via the Admin SDK and check request.auth.token.role
// here instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
